NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:4000
API_PORT=4000
# Optional web port override; otherwise use APP_URL's port, then 3000.
# WEB_PORT=3000
# WEB_BIND_HOST=0.0.0.0
DB_HOST=localhost
DB_PORT=1433
DB_DATABASE=IslandHostOne_Dev
DB_USERNAME=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_CERTIFICATE=false
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECURE=false
TRUST_PROXY=false
SWAGGER_ENABLED=true
SEED_PASSWORD=
SEED_ADMIN_EMAIL=admin@islandhost.example
SEED_CUSTOMER_EMAIL=guest@islandhost.example
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_MODE=file
SERVICE_IMAGE_HOSTS=
# Optional persistent photo folder; default is uploads/service-photos under the app root.
# Preserve and back up this directory separately from the app build and SQL database.
# SERVICE_UPLOAD_DIR=uploads/service-photos
# Separate, disposable SQL Server database for the real integration suite:
TEST_DB_DATABASE=IslandHostOne_Test

# Production finance and optional communications transport:
PAYMENT_PROVIDER=manual
REALTIME_ENABLED=false

# One-time transfer destination. Keep DB_* above pointing to the source.
# MIGRATION_DB_HOST=sql8011.site4now.net
# MIGRATION_DB_DATABASE=db_9aa62b_islandhost
# MIGRATION_DB_USERNAME=db_9aa62b_islandhost_admin
# MIGRATION_DB_PORT=1433
# MIGRATION_DB_PASSWORD=
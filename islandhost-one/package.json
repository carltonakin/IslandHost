{
    "name":  "islandhost-one",
    "version":  "1.0.0",
    "private":  true,
    "workspaces":  [
                       "backend",
                       "frontend"
                   ],
    "engines":  {
                    "node":  "\u003e=22.0.0"
                },
    "scripts":  {
                    "dev":  "concurrently -n API,WEB -c cyan,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
                    "build":  "npm run build -w backend \u0026\u0026 npm run build -w frontend",
                    "typecheck":  "npm run typecheck -w backend \u0026\u0026 npm run typecheck -w frontend",
                    "lint":  "eslint backend/src backend/test frontend/src",
                    "test":  "npm run test -w backend",
                    "test:integration":  "npm run test:integration -w backend",
                    "db:migrate":  "npm run db:migrate -w backend",
                    "db:seed":  "npm run db:seed -w backend",
                    "admin:create":  "npm run admin:create -w backend",
                    "test:browser":  "playwright test"
                },
    "devDependencies":  {
                            "@eslint/js":  "^9.39.0",
                            "@playwright/test":  "^1.63.0",
                            "concurrently":  "^9.2.0",
                            "eslint":  "^9.39.0",
                            "typescript":  "^5.9.3",
                            "typescript-eslint":  "^8.48.0"
                        }
}
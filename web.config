<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <remove name="httpPlatformHandler" />
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpErrors existingResponse="PassThrough" />
    <httpPlatform processPath="c:\Program Files\nodejs\node.exe"
                  arguments="scripts/run.cjs start --iis-port %HTTP_PLATFORM_PORT%"
                  startupTimeLimit="120"
                  startupRetryCount="2"
                  processesPerApplication="1"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\islandhost-node.log">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <!-- Public settings for this site. IIS values take precedence over .env. -->
        <environmentVariable name="APP_URL" value="https://carlitoh-001-site8.dtempurl.com" />
        <environmentVariable name="API_URL" value="http://127.0.0.1:4000" />
        <environmentVariable name="API_PORT" value="4000" />
        <environmentVariable name="DB_DRIVER" value="tcp" />
        <environmentVariable name="DB_ENCRYPT" value="true" />
        <environmentVariable name="DB_TRUST_CERTIFICATE" value="false" />
        <environmentVariable name="COOKIE_SECURE" value="true" />
        <environmentVariable name="MAIL_MODE" value="smtp" />
        <environmentVariable name="SWAGGER_ENABLED" value="false" />
        <!-- Database/JWT/SMTP credentials belong in the private hosted environment. -->
        <environmentVariable name="LOCALAPPDATA" value="h:\root\home\carlitoh-001\www\islandhost\AppData\Local" />
        <environmentVariable name="NEXT_SWC_PATH" value="h:\root\home\carlitoh-001\www\islandhost\AppData\Local" />
        <environmentVariable name="WEB_BIND_HOST" value="127.0.0.1" />
        <environmentVariable name="API_BIND_HOST" value="127.0.0.1" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>

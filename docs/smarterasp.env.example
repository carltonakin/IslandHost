# Copy to the hosted site's private root .env, then fill every blank below.
# The workstation .env must not be uploaded.
NODE_ENV=production
APP_URL=https://carlitoh-001-site8.dtempurl.com
API_URL=http://127.0.0.1:4000
API_PORT=4000
API_BIND_HOST=127.0.0.1
WEB_BIND_HOST=127.0.0.1
DB_DRIVER=tcp
DB_HOST=sql8011.site4now.net
DB_PORT=1433
DB_DATABASE=db_9aa62b_islandhost
DB_USERNAME=db_9aa62b_islandhost_admin
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_CERTIFICATE=false
# Two different random secrets, each at least 48 characters.
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECURE=true
MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
# Required if the SMTP provider requires authentication.
SMTP_USER=
SMTP_PASSWORD=
TRUST_PROXY=false
SWAGGER_ENABLED=false
SERVICE_IMAGE_HOSTS=
# Optional persistent photo folder; default is uploads/service-photos under the app root.
# Preserve and back up this directory separately from the app build and SQL database.
# SERVICE_UPLOAD_DIR=uploads/service-photos
PAYMENT_PROVIDER=manual
REALTIME_ENABLED=false
